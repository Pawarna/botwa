# Backend Environment Variables

# Supabase PostgreSQL Database URL (Connection Pooling URL recommended)
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=2"

# Supabase URL for Auth and Storage
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"

# Supabase Service Role Key (Used for validating JWTs and accessing Storage)
SUPABASE_KEY="your-supabase-service-role-key"

# Port for the backend server
PORT=3000
