generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WhatsAppAuth {
  sessionId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([sessionId, key])
}

model AutoReply {
  id        String   @id @default(uuid())
  sessionId String
  keyword   String
  replyText String
  isExact   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

model BlastQueue {
  id          String      @id @default(uuid())
  sessionId   String
  targetJid   String
  messageText String
  mediaUrl    String?
  mediaType   String?
  status      BlastStatus @default(PENDING)
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sessionId])
  @@index([status])
}

model ScrapeBatch {
  id        String           @id @default(uuid())
  query     String
  createdAt DateTime         @default(now())
  contacts  ScrapedContact[]
}

model ScrapedContact {
  id            String      @id @default(uuid())
  batchId       String
  name          String
  phone         String
  address       String?
  rating        String?
  website       String?
  email         String?
  mapsUrl       String?
  contactStatus String      @default("unsent")
  contactedAt   DateTime?
  emailSentAt   DateTime?
  batch         ScrapeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

enum BlastStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}
