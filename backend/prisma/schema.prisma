generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WhatsAppAuth {
  sessionId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([sessionId, key])
}

model AutoReply {
  id        String   @id @default(uuid())
  sessionId String
  keyword   String
  replyText String
  isExact   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}

model BlastQueue {
  id          String      @id @default(uuid())
  sessionId   String
  targetJid   String
  messageText String
  messageVariants String?
  mediaUrl    String?
  mediaType   String?
  contactId   String?
  status      BlastStatus @default(PENDING)
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sessionId])
  @@index([status])
}

model EmailQueue {
  id          String      @id @default(uuid())
  targetEmail String
  subject     String
  body        String
  bodyHtml    String?
  bodyVariants String?
  subjectVariants String?
  contactId   String?
  status      BlastStatus @default(PENDING)
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

model ScrapeBatch {
  id        String           @id @default(uuid())
  query     String
  createdAt DateTime         @default(now())
  contacts  ScrapedContact[]
}

model ScrapedContact {
  id            String      @id @default(uuid())
  batchId       String
  name          String
  phone         String
  address       String?
  rating        String?
  website       String?
  email         String?
  mapsUrl       String?
  contactStatus String      @default("unsent")
  contactedAt   DateTime?
  emailSentAt   DateTime?
  batch         ScrapeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

// ─── Project Management ───────────────────────────────────────────────────────

model ClientLead {
  id          String     @id @default(uuid())
  name        String
  phone       String?
  email       String?
  address     String?
  website     String?
  source      String     @default("manual")
  batchQuery  String?
  status      LeadStatus @default(SCRAPED)
  notes       String?
  contactedAt DateTime?
  project     Project?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  clientName  String
  clientPhone String?
  clientEmail String?
  source      String        @default("manual")
  notes       String?
  leadId      String?       @unique
  lead        ClientLead?   @relation(fields: [leadId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model MessageTemplate {
  id        String   @id @default(uuid())
  sessionId String?
  channel   String   // 'wa' | 'email'
  subject   String?  // khusus email
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, channel])
}

enum BlastStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum LeadStatus {
  SCRAPED
  CONTACTED
  PROPOSAL_SENT
  ACCEPTED
  REJECTED
}

enum ProjectStatus {
  PLANNING
  DEVELOPMENT
  REVIEW
  COMPLETED
  ON_HOLD
}
